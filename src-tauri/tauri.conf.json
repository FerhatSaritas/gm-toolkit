{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GM Toolkit",
  "version": "0.1.0",
  "identifier": "app.gmtoolkit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GM Toolkit",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "shortDescription": "Local-first GM toolkit for running TTRPGs",
    "longDescription": "GM Toolkit is a private, offline grimoire for Game Masters: scene and encounter views over plain Markdown + YAML blueprints, a live combat tracker with initiative and HP management, a bestiary and NPC gallery, statblock import, generators, and global search. All campaign data stays on your disk.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  }
}
